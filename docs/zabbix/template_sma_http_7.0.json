    "templates": [
      {
        "uuid": "61ffa1194b1a4570a7f83bf3e789ffcb",
        "template": "SMA by HTTP",
        "name": "SMA by HTTP",
        "description": "SMA v1 snapshot over HTTP. Linux and Windows core metrics, filesystem and disk discovery. Read docs/zabbix-integration.md before import. Set host macros SMA.URL and secret SMA.TOKEN; no real credentials included. CPU percentage uses per-core idle change over elapsed reception time, not delta-total. No notification actions are installed.",
        "groups": [
          {
            "name": "Templates/SMA"
          }
        ],
        "items": [
          {
            "uuid": "22e6f34e7f594e959b0e91d29b50073d",
            "name": "SMA: Get snapshot",
            "type": "HTTP_AGENT",
            "key": "sma.snapshot",
            "delay": "{$SMA.INTERVAL}",
            "history": "1d",
            "trends": "0",
            "value_type": "TEXT",
            "timeout": "{$SMA.TIMEOUT}",
            "url": "{$SMA.URL}/v1/snapshot",
            "status_codes": "200",
            "follow_redirects": "NO",
            "retrieve_mode": "BODY",
            "request_method": "GET",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {$SMA.TOKEN}"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "verify_peer": "YES",
            "verify_host": "YES",
            "description": "Read-only GET. Configure SMA.URL and secret SMA.TOKEN on each host. Test-window macro overrides do not update saved host macros. HTTP 200 can include partial collector failures.",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var s = JSON.parse(value);\nif (s.schemaVersion !== 'v1') throw 'Unsupported SMA schemaVersion';\nreturn value;"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "raw"
              }
            ],
            "triggers": [
              {
                "uuid": "5bd9f053f5d248febf758bc307ae0282",
                "expression": "nodata(/SMA by HTTP/sma.snapshot,3m)=1",
                "name": "SMA: No snapshot for 3m",
                "priority": "AVERAGE"
              }
            ]
          },
