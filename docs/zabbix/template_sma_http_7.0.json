          {
            "uuid": "c637ef815ca740dc8cb43eb372e1721d",
            "name": "SMA: Memory used percent",
            "type": "DEPENDENT",
            "key": "sma.memory.used.pct",
            "delay": "0",
            "history": "7d",
            "trends": "365d",
            "value_type": "FLOAT",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var s = JSON.parse(value), m = s.memory;\nif (!m || typeof m.totalBytes !== 'number' || m.totalBytes <= 0 ||\n    typeof m.availableBytes !== 'number' || m.availableBytes < 0 ||\n    m.availableBytes > m.totalBytes) throw 'Invalid or missing memory data';\nreturn 100 * (1 - m.availableBytes / m.totalBytes);"
                ]
              }
            ],
            "master_item": {
              "key": "sma.snapshot"
            },
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ],
            "units": "%",
            "triggers": [
              {
                "uuid": "ea5c472173f74d1db66e341efa8fe381",
                "expression": "min(/SMA by HTTP/sma.memory.used.pct,5m)>{$SMA.MEM.WARN}",
                "name": "SMA: Memory usage high",
                "priority": "WARNING",
                "recovery_mode": "RECOVERY_EXPRESSION",
                "recovery_expression": "max(/SMA by HTTP/sma.memory.used.pct,5m)<{$SMA.MEM.RECOVER}"
              },
              {
                "uuid": "1438033ad6f3466ebc1f4aa6829bc9bb",
                "expression": "nodata(/SMA by HTTP/sma.memory.used.pct,3m)=1",
                "name": "SMA: Memory data missing",
                "priority": "WARNING"
              }
            ]
          },
          {
            "uuid": "1b6640ab77be46ada51c22e13d94159b",
            "name": "SMA: CPU used percent",
            "type": "DEPENDENT",
            "key": "sma.cpu.used.pct",
            "delay": "0",
            "history": "7d",
            "trends": "365d",
            "value_type": "FLOAT",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var s = JSON.parse(value), c = s.cpu;\nif (!c || typeof c.logicalCount !== 'number' || c.logicalCount <= 0 || !c.seconds)\n    throw 'Invalid or missing CPU data';\nvar idle = 0, rows = 0;\nfor (var name in c.seconds) {\n    if (!Object.prototype.hasOwnProperty.call(c.seconds, name)) continue;\n    var n = c.seconds[name].idle;\n    if (typeof n !== 'number' || !isFinite(n) || n < 0) throw 'Invalid CPU idle time';\n    idle += n; rows++;\n}\nif (!rows) throw 'CPU list empty';\nif (Object.prototype.hasOwnProperty.call(c.seconds, 'total')) {\n    if (rows !== 1) throw 'Mixed aggregate and per-core CPU data';\n} else if (rows !== c.logicalCount) throw 'CPU count mismatch';\nreturn idle / c.logicalCount;"
                ]
              },
              {
                "type": "CHANGE_PER_SECOND",
                "parameters": [
                  ""
                ]
              },
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var pct = 100 * (1 - Number(value));\nif (!isFinite(pct) || pct < 0 || pct > 100) throw 'CPU sample outside 0..100; wait for stable samples';\nreturn pct;"
                ]
              }
            ],
            "master_item": {
              "key": "sma.snapshot"
            },
            "tags": [
              {
                "tag": "component",
                "value": "cpu"
              }
            ],
            "units": "%",
            "description": "100 * (1 - change_per_second(sum(idle)/logicalCount)). Requires two samples and stable CPU topology; accounts iowait as non-idle. Sampling and network timing may differ from delta-total accounting. Restart/counter decrease rebuilds baseline. No CPU threshold trigger is enabled by this template."
          },
