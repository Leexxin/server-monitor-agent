          {
            "uuid": "7ab855e1996b48d587feb6baf8513a44",
            "name": "SMA: System filesystem used percent",
            "type": "DEPENDENT",
            "key": "sma.fs.system.used.pct",
            "delay": "0",
            "history": "7d",
            "trends": "365d",
            "value_type": "FLOAT",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var s = JSON.parse(value), mount = s.host && s.host.systemMountpoint;\nif (!mount) {\n    if (s.host && s.host.os === 'windows') throw 'Windows systemMountpoint missing';\n    mount = '/';\n}\nvar fs = s.filesystems || [];\nfor (var i = 0; i < fs.length; i++) {\n    var f = fs[i];\n    if (f.mountpoint !== mount) continue;\n    if (typeof f.sizeBytes !== 'number' || f.sizeBytes <= 0 ||\n        typeof f.availableBytes !== 'number' || f.availableBytes < 0 ||\n        f.availableBytes > f.sizeBytes) throw 'Invalid system filesystem data';\n    return 100 * (1 - f.availableBytes / f.sizeBytes);\n}\nthrow 'System filesystem missing';"
                ]
              }
            ],
            "master_item": {
              "key": "sma.snapshot"
            },
            "tags": [
              {
                "tag": "component",
                "value": "fs"
              }
            ],
            "units": "%",
            "triggers": [
              {
                "uuid": "98deb7c600994f2d8b08e57bcd6c1d6c",
                "expression": "nodata(/SMA by HTTP/sma.fs.system.used.pct,3m)=1",
                "name": "SMA: System filesystem data missing",
                "priority": "WARNING"
              }
            ]
          }
        ],
        "discovery_rules": [
          {
            "uuid": "c905ca97c3cf4afeab14b743025ed5ee",
            "name": "SMA: Filesystem discovery",
            "type": "DEPENDENT",
            "key": "sma.fs.discovery",
            "delay": "0",
            "master_item": {
              "key": "sma.snapshot"
            },
            "lifetime": "7d",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var s = JSON.parse(value), errors = s.errors || [];\nfor (var i = 0; i < errors.length; i++) {\n    if (errors[i].collector === 'filesystem') throw 'Collector failed; preserve discovery resources';\n}\nif (!Array.isArray(s.filesystems)) throw 'Discovery array missing';\nreturn JSON.stringify(s.filesystems);"
                ]
              }
            ],
            "lld_macro_paths": [
              {
                "lld_macro": "{#SMA.MOUNT}",
                "path": "$.mountpoint"
              },
              {
                "lld_macro": "{#SMA.FSTYPE}",
                "path": "$.filesystemType"
              }
            ],
            "item_prototypes": [
              {
                "uuid": "0f4f0efe3510415fac0f4e0588e56240",
                "name": "SMA: FS {#SMA.MOUNT}: Size",
                "type": "DEPENDENT",
                "key": "sma.fs.size[\"{#SMA.MOUNT}\"]",
                "delay": "0",
                "history": "7d",
                "trends": "365d",
                "value_type": "UNSIGNED",
                "master_item": {
                  "key": "sma.snapshot"
                },
                "preprocessing": [
                  {
                    "type": "JSONPATH",
                    "parameters": [
                      "$.filesystems[?(@.mountpoint == \"{#SMA.MOUNT}\")].sizeBytes.first()"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "filesystem"
                  }
                ],
                "units": "B"
              },
              {
                "uuid": "bea264a34f1a4d8d9d75c50f406b5c44",
                "name": "SMA: FS {#SMA.MOUNT}: Available",
                "type": "DEPENDENT",
                "key": "sma.fs.available[\"{#SMA.MOUNT}\"]",
                "delay": "0",
                "history": "7d",
                "trends": "365d",
                "value_type": "UNSIGNED",
                "master_item": {
                  "key": "sma.snapshot"
                },
                "preprocessing": [
                  {
                    "type": "JSONPATH",
                    "parameters": [
                      "$.filesystems[?(@.mountpoint == \"{#SMA.MOUNT}\")].availableBytes.first()"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "filesystem"
                  }
                ],
                "units": "B"
              },
              {
                "uuid": "615ed57293874cba92d1274dd99f09a3",
                "name": "SMA: FS {#SMA.MOUNT}: Used percent",
                "type": "DEPENDENT",
                "key": "sma.fs.used.pct[\"{#SMA.MOUNT}\"]",
                "delay": "0",
                "history": "7d",
                "trends": "365d",
                "value_type": "FLOAT",
                "master_item": {
                  "key": "sma.snapshot"
                },
                "preprocessing": [
                  {
                    "type": "JSONPATH",
                    "parameters": [
                      "$.filesystems[?(@.mountpoint == \"{#SMA.MOUNT}\")].first()"
                    ]
                  },
                  {
                    "type": "JAVASCRIPT",
                    "parameters": [
                      "var f = JSON.parse(value);\nif (typeof f.sizeBytes !== 'number' || f.sizeBytes <= 0 ||\n    typeof f.availableBytes !== 'number' || f.availableBytes < 0 ||\n    f.availableBytes > f.sizeBytes) throw 'Invalid filesystem data';\nreturn 100 * (1 - f.availableBytes / f.sizeBytes);"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "filesystem"
                  }
                ],
                "units": "%",
                "trigger_prototypes": [
                  {
                    "uuid": "32adb587161a4218a9cd4c008a6a7f17",
                    "expression": "min(/SMA by HTTP/sma.fs.used.pct[\"{#SMA.MOUNT}\"],5m)>{$SMA.FS.WARN}",
                    "name": "SMA: FS {#SMA.MOUNT}: Space usage high",
                    "priority": "WARNING",
                    "recovery_mode": "RECOVERY_EXPRESSION",
                    "recovery_expression": "max(/SMA by HTTP/sma.fs.used.pct[\"{#SMA.MOUNT}\"],5m)<{$SMA.FS.RECOVER}"
                  }
                ]
              }
            ],
            "filter": {
              "evaltype": "AND",
              "conditions": [
                {
                  "macro": "{#SMA.MOUNT}",
                  "value": "{$SMA.FS.MATCHES}",
                  "operator": "MATCHES_REGEX",
                  "formulaid": "A"
                },
                {
                  "macro": "{#SMA.FSTYPE}",
                  "value": "{$SMA.FS.FSTYPE.NOT_MATCHES}",
                  "operator": "NOT_MATCHES_REGEX",
                  "formulaid": "B"
                }
              ]
            },
            "enabled_lifetime_type": "DISABLE_AFTER",
            "enabled_lifetime": "1d"
          },
          {
            "uuid": "8fb415487b294ef0ae8b3e07d9acc2f2",
            "name": "SMA: Disk discovery",
            "type": "DEPENDENT",
            "key": "sma.disk.discovery",
            "delay": "0",
            "master_item": {
              "key": "sma.snapshot"
            },
            "lifetime": "7d",
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var s = JSON.parse(value), errors = s.errors || [];\nfor (var i = 0; i < errors.length; i++) {\n    if (errors[i].collector === 'disk') throw 'Collector failed; preserve discovery resources';\n}\nif (!Array.isArray(s.disks)) throw 'Discovery array missing';\nreturn JSON.stringify(s.disks);"
                ]
              }
            ],
            "lld_macro_paths": [
              {
                "lld_macro": "{#SMA.DEVICE}",
                "path": "$.device"
              }
            ],
            "item_prototypes": [
              {
                "uuid": "1002b2efb81a431488a3918154c4c1a2",
                "name": "SMA: Disk {#SMA.DEVICE}: Read bytes per second",
                "type": "DEPENDENT",
                "key": "sma.disk.read.bps[\"{#SMA.DEVICE}\"]",
                "delay": "0",
                "history": "7d",
                "trends": "365d",
                "value_type": "FLOAT",
                "master_item": {
                  "key": "sma.snapshot"
                },
                "preprocessing": [
                  {
                    "type": "JSONPATH",
                    "parameters": [
                      "$.disks[?(@.device == \"{#SMA.DEVICE}\")].readBytes.first()"
                    ]
