# SMA command-line arguments. Restart the service after changing this file.
# Remote access example:
# SMA_OPTS="--listen-address=0.0.0.0:9108 --web.auth-token-file=/opt/sma/config/token"
# Discovery reporting example:
# SMA_OPTS="--listen-address=0.0.0.0:9108 --web.auth-token-file=/opt/sma/config/token --discovery.report-url=https://cmdb.example.com/api/v1/sma/discovery --discovery.report-token-file=/opt/sma/config/report-token"
SMA_OPTS="--listen-address=127.0.0.1:9108"
