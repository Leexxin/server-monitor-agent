#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    if [ -r /opt/sma/config/sma.env ]; then
        . /opt/sma/config/sma.env
    fi
    # SMA_OPTS is the same simple, whitespace-separated argument list used by
    # the other Linux service files. Disable glob expansion before splitting.
    set -f
    set -- ${SMA_OPTS:-}
    set +f
    procd_open_instance
    procd_set_param command /opt/sma/bin/sma "$@"
    procd_set_param user sma
    procd_set_param group sma
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
