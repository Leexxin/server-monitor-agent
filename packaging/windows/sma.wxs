<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <!-- Keep the package identity language compatible with the first MSI; UI is localized separately. -->
  <Product Id="*" Name="SMA" Language="1033" Codepage="936" Version="$(var.MsiVersion)" Manufacturer="SMA Project" UpgradeCode="48D2A5BA-96F0-4457-98A0-CBE35CE7247C">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" Description="SMA Windows monitoring agent" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="已安装更新版本的 SMA，不能降级。" />
    <Condition Message="SMA requires 64-bit Windows.">Installed OR VersionNT64</Condition>
    <Property Id="SMA_NET_RELEASE"><RegistrySearch Id="FrameworkRelease" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Win64="yes" /></Property>
    <Condition Message="SMA 管理界面需要 .NET Framework 4.7.2 或更新版本。请先启用或安装此 Windows 组件。">Installed OR SMA_NET_RELEASE &gt;= "#461808"</Condition>
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Leexxin/server-monitor-agent" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="SMA">
          <Component Id="Agent" Guid="F4E6F765-3BA9-47EF-9DA5-E149CA0695EA" Win64="yes">
            <File Id="AgentExe" Source="$(var.Payload)\sma.exe" KeyPath="yes" />
            <ServiceInstall Id="ServiceInstall" Name="SMA" DisplayName="SMA Server Monitor Agent" Description="Lightweight CPU, memory and disk monitoring agent" Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
              <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
            </ServiceInstall>
            <ServiceControl Id="ServiceControl" Name="SMA" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
          <Component Id="Management" Guid="878976EA-3EA3-4EF5-9546-8A908CFA42FD" Win64="yes">
            <File Id="CtlExe" Source="$(var.Payload)\sma-ctl.exe" KeyPath="yes" />
          </Component>
          <Component Id="Gui" Guid="59D882F2-041C-4E7D-9138-CFD53FE0E45F" Win64="yes">
            <File Id="GuiExe" Source="$(var.Payload)\sma-gui.exe" KeyPath="yes">
              <Shortcut Id="GuiStartMenu" Directory="SmaMenu" Name="SMA 管理中心" Advertise="yes" WorkingDirectory="INSTALLDIR" />
            </File>
            <RemoveFolder Id="RemoveSmaMenu" Directory="SmaMenu" On="uninstall" />
          </Component>
          <Component Id="Registration" Guid="7F92A7C2-E54F-499D-A014-612C3C62939B" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\SMA" Name="ProductCode" Value="[ProductCode]" Type="string" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="Software\SMA" Name="Version" Value="$(var.DisplayVersion)" Type="string" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"><Directory Id="SmaMenu" Name="SMA" /></Directory>
    </Directory>
    <CustomAction Id="Provision" FileKey="CtlExe" ExeCommand="provision" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="Provision" After="InstallFiles">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
    <Feature Id="Complete" Title="SMA" Level="1">
      <ComponentRef Id="Agent" /><ComponentRef Id="Management" /><ComponentRef Id="Registration" /><ComponentRef Id="Gui" />
      <ComponentGroupRef Id="SupportFiles" />
    </Feature>
    <UIRef Id="SmaInstallerUI" />
  </Product>
</Wix>
